programa {
  funcao inicio() {

    inteiro numero = 10
    real numeroReal = 12.5 
    caracter opcao = 'a'
    logico status = verdadeiro 
    cadeia frase = "A turma 67 é TOP!"
    
    //Exibir os dados das variaveis na tela 
    
    escreva(numero)
    escreva("\n" + numeroReal)
    escreva("\n" + opcao)
    escreva("\n" + status)
    escreva("\n" + frase)




  }
}
